{
  "name": "site-landing-template",
  "description": "White-label Astro 7 SSR template for a backend-driven marketing site. Plug in any HTTP backend that implements the contract in src/lib/dto.ts, or run the bundled demo with DEMO_MODE=true.",
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "astro": "astro",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config tests/e2e/playwright.config.ts --ui",
    "test:e2e:degraded": "npm run build && playwright test --config tests/e2e/playwright.degraded.config.ts",
    "test:e2e:empty": "MOCK_BACKEND_MODE=empty npm run test:e2e",
    "pretest:lh": "npm run build",
    "test:lh": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.4",
    "astro-icon": "^1.1.5",
    "astro-robots-txt": "^1.0.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "tmp": "^0.2.7"
  }
}
