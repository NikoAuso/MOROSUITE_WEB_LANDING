{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@config": ["./site.config.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "site.config.ts", "tests/**/*"],
  "exclude": ["dist"]
}
