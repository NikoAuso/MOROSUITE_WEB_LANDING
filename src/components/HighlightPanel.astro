---
import type { SitePayload } from '@/lib/dto';
import type { HighlightContent } from '@/lib/sections';
import CtaButton from '@/components/CtaButton.astro';
import { FALLBACK_COPY } from '@/lib/copy';

interface Props {
  id: string;
  site: SitePayload;
  content: HighlightContent;
}

const { id, site, content } = Astro.props;
const { title, lead, items: sections, images } = content;
const booking = site.links?.booking ?? null;
---

<section id={id} class="bg-brand-900 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <h2 class="text-3xl font-extrabold tracking-tight">{title}</h2>
        <p class="mt-4 text-white/80">
          {lead}
        </p>

        <div class="mt-6 grid gap-3">
          {
            sections.map((s) => (
              <div class="group rounded-2xl bg-white/10 p-4">
                <div class="font-semibold flex items-center justify-between">{s.title}</div>
                <p class="mt-2 text-sm text-white/80">{s.text}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <CtaButton
            link={booking}
            fallbackLabel={FALLBACK_COPY.cta.booking}
            class="inline-flex items-center justify-center rounded-2xl bg-cta-700 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-cta-800 transition"
          />
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="grid gap-4 sm:grid-cols-2">
          {
            images.map((image) => (
              <div
                class:list={[
                  'overflow-hidden rounded-3xl bg-white/10',
                  image.wide && 'sm:col-span-2',
                ]}
              >
                <img
                  class="h-56 w-full object-cover"
                  loading="lazy"
                  decoding="async"
                  src={image.src}
                  width={image.wide ? 1200 : 600}
                  height={400}
                  alt={image.alt}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
