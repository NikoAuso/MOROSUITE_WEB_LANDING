---
import Icon from '@/components/Icon.astro';
import type { ServicesContent } from '@/lib/sections';

interface Props {
  id: string;
  content: ServicesContent;
}

const { id, content } = Astro.props;
const { eyebrow, title, lead, items: services, cards } = content;
const [firstCard, secondCard] = cards;
---

<section id={id} class="bg-sky-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="text-center">
      <div class="text-xs font-semibold tracking-widest text-sky-700">{eyebrow}</div>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
        {title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        {lead}
      </p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7 grid gap-6 sm:grid-cols-2">
        {
          firstCard && (
            <div class="rounded-3xl overflow-hidden bg-white shadow-sm ring-1 ring-slate-200">
              <div class="aspect-[4/3] bg-slate-200">
                <img
                  src={firstCard.image}
                  class="h-full w-full object-cover"
                  alt={firstCard.alt}
                  loading="lazy"
                  decoding="async"
                  width="700"
                  height="525"
                />
              </div>
              <div class="p-6">
                <div class="text-lg font-extrabold text-slate-900">{firstCard.title}</div>
                <div class="mt-1 text-sm text-slate-600">{firstCard.subtitle}</div>
              </div>
            </div>
          )
        }

        {
          secondCard && (
            <div class="rounded-3xl overflow-hidden bg-white shadow-sm ring-1 ring-slate-200">
              <div class="p-6">
                <div class="text-lg font-extrabold text-slate-900">{secondCard.title}</div>
                <div class="mt-1 text-sm text-slate-600">{secondCard.subtitle}</div>
              </div>
              <div class="aspect-[4/3] bg-slate-200">
                <img
                  src={secondCard.image}
                  class="h-full w-full object-cover"
                  alt={secondCard.alt}
                  loading="lazy"
                  decoding="async"
                  width="700"
                  height="525"
                />
              </div>
            </div>
          )
        }
      </div>

      <div class="lg:col-span-5">
        <div class="space-y-5">
          {
            services.map((s) => (
              <div class="flex gap-4">
                <div class="mt-1 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
                  <Icon name={s.icon} class="text-xl leading-none" />
                </div>
                <div>
                  <div class="font-extrabold text-slate-900">{s.title}</div>
                  <div class="mt-1 text-sm text-slate-600">{s.text}</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
