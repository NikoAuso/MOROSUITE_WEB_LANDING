---
import type { StoryContent } from '@/lib/sections';

interface Props {
  id: string;
  content: StoryContent;
}

const { id, content } = Astro.props;
const { eyebrow, title, paragraphs, image, imageSide = 'left' } = content;
---

<section id={id} class="bg-brand-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class:list={['lg:col-span-6', imageSide === 'right' && 'lg:order-2']}>
        <div
          class="aspect-[4/3] overflow-hidden rounded-3xl bg-slate-200 shadow-sm ring-1 ring-slate-200"
        >
          <img
            src={image.src}
            alt={image.alt}
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="800"
            height="600"
          />
        </div>
      </div>
      <div class="lg:col-span-6">
        <div class="text-xs font-semibold tracking-widest text-brand-700">{eyebrow}</div>
        <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">{title}</h2>
        <div class="mt-6 space-y-4 text-slate-600">
          {paragraphs.map((text) => <p>{text}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>
