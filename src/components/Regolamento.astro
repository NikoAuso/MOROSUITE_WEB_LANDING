---
import type { SitePayload } from '@/lib/dto';
import CtaButton from '@/components/CtaButton.astro';
import { FALLBACK_COPY } from '@/lib/copy';

interface Props {
  site: SitePayload;
}

const { site } = Astro.props;
const booking = site.links?.booking ?? null;
const whatsapp = site.contacts?.whatsapp;
const whatsappUrl = whatsapp ? `https://wa.me/${whatsapp.replace(/[^0-9]/g, '')}` : null;

const obbligatorio = [
  'Farsi la doccia prima di entrare in acqua.',
  "L'uso della cuffia.",
  "L'uso delle ciabatte all'interno dell'area piscine.",
  'Accompagnare i bambini sotto i 12 anni.',
  'Gli utenti minori di 3 anni o fisiologicamente incontinenti devono indossare costumi contenitivi.',
  'Servirsi dei cestini per i rifiuti.',
];

const vietato = [
  'Tuffarsi.',
  "Portare bicchieri e bottiglie in vetro nell'area piscine.",
  "Portare e consumare cibo nell'area piscine e negli spogliatoi.",
  'Entrare in vasca alle persone che presentano ferite, abrasioni, lesioni, o alterazioni cutanee di sospetta natura infetta.',
  'Recare disturbo al prossimo.',
  'Rimanere nelle vasche con il maltempo.',
  'Accesso a animali di qualsiasi taglia.',
];

const inoltre = [
  'La direzione non risponde in alcun modo degli eventuali incidenti, infortuni o altro che possono accadere ai bagnanti per comportamenti a loro imputabili.',
  "La direzione non è responsabile di furti o smarrimenti di oggetti lasciati incustoditi all'interno della struttura e non assume alcuna responsabilità nemmeno per gli oggetti lasciati negli armadietti.",
  'Il personale di servizio può allontanare chi arreca disturbo con comportamenti inadeguati.',
  'La direzione può chiedere di mostrare il biglietto in ogni momento.',
  'Portare cibo e bevande da casa, da consumare esclusivamente nelle apposite aree esterne alla struttura.',
];
---

<section id="regolamento" class="bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-24 self-start">
        <div class="text-xs font-semibold tracking-widest text-sky-700">REGOLAMENTO</div>
        <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
          Regole principali
        </h2>
        <p class="mt-4 text-slate-600">
          Per garantire sicurezza, igiene e un'esperienza piacevole a tutti gli ospiti, è richiesto
          il rispetto delle regole riportate di seguito.
        </p>

        <div class="mt-8 hidden lg:block rounded-3xl bg-sky-50 p-6 ring-1 ring-sky-100">
          <div class="text-sm font-extrabold text-slate-900">Nota importante</div>
          <p class="mt-2 text-sm text-slate-700">
            Il personale di servizio può allontanare chi arreca disturbo con comportamenti
            inadeguati. La direzione può chiedere di mostrare il biglietto in ogni momento.
          </p>
        </div>

        <div class="mt-6 hidden lg:block rounded-3xl bg-white p-7 shadow-lg ring-1 ring-slate-200">
          <div class="text-lg font-extrabold text-slate-900">Hai dubbi?</div>
          <p class="mt-2 text-sm text-slate-600">
            Scrivici su WhatsApp per assistenza rapida, oppure procedi direttamente con la
            prenotazione.
          </p>

          <div class="mt-6 flex flex-col gap-3">
            {
              whatsappUrl && (
                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-2xl bg-green-700 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-green-800 transition focus:outline-none focus:ring-2 focus:ring-green-600/40"
                >
                  <i class="fa-brands fa-whatsapp text-lg leading-none" aria-hidden="true" />
                  <span>Scrivici su WhatsApp</span>
                </a>
              )
            }

            <CtaButton
              link={booking}
              fallbackLabel={FALLBACK_COPY.cta.booking}
              class="inline-flex items-center justify-center rounded-2xl border border-green-700 px-6 py-3 text-sm font-semibold text-green-700 hover:bg-green-50 transition focus:outline-none focus:ring-2 focus:ring-green-600/20"
            />

            <p class="text-xs text-slate-500">
              Rispondiamo appena possibile durante gli orari di apertura.
            </p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid gap-6">
          <details open class="group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden"
            >
              <div class="text-lg font-extrabold text-slate-900">Obbligatorio</div>
              <div class="flex items-center gap-3">
                <span
                  class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800"
                >
                  Da rispettare sempre
                </span>
                <svg
                  class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                </svg>
              </div>
            </summary>
            <ul class="mt-4 space-y-3 text-sm text-slate-700">
              {
                obbligatorio.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-green-700" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </details>

          <details open class="group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden"
            >
              <div class="text-lg font-extrabold text-slate-900">È vietato</div>
              <div class="flex items-center gap-3">
                <span
                  class="inline-flex items-center rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-800"
                >
                  Non consentito
                </span>
                <svg
                  class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                </svg>
              </div>
            </summary>
            <ul class="mt-4 space-y-3 text-sm text-slate-700">
              {
                vietato.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-red-600" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </details>

          <details open class="group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden"
            >
              <div class="text-lg font-extrabold text-slate-900">Inoltre</div>
              <svg
                class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"
                ></path>
              </svg>
            </summary>
            <ul class="mt-4 space-y-3 text-sm text-slate-700">
              {
                inoltre.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-slate-600" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </details>

          <div class="lg:hidden rounded-3xl bg-sky-50 p-6 ring-1 ring-sky-100">
            <div class="text-sm font-extrabold text-slate-900">Nota importante</div>
            <p class="mt-2 text-sm text-slate-700">
              Il personale di servizio può allontanare chi arreca disturbo con comportamenti
              inadeguati. La direzione può chiedere di mostrare il biglietto in ogni momento.
            </p>
          </div>

          <div class="lg:hidden rounded-3xl bg-white p-7 shadow-lg ring-1 ring-slate-200">
            <div class="text-lg font-extrabold text-slate-900">Hai dubbi?</div>
            <p class="mt-2 text-sm text-slate-600">
              Scrivici su WhatsApp per assistenza rapida, oppure procedi direttamente con la
              prenotazione.
            </p>

            <div class="mt-6 flex flex-col gap-3">
              {
                whatsappUrl && (
                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 rounded-2xl bg-green-700 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-green-800 transition focus:outline-none focus:ring-2 focus:ring-green-600/40"
                  >
                    <i class="fa-brands fa-whatsapp text-lg leading-none" aria-hidden="true" />
                    <span>Scrivici su WhatsApp</span>
                  </a>
                )
              }

              <CtaButton
                link={booking}
                fallbackLabel={FALLBACK_COPY.cta.booking}
                class="inline-flex items-center justify-center rounded-2xl border border-green-700 px-6 py-3 text-sm font-semibold text-green-700 hover:bg-green-50 transition focus:outline-none focus:ring-2 focus:ring-green-600/20"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
