---
const services = [
  { icon: 'fa-martini-glass-citrus', title: 'Bar & Ristorante', text: 'Cocktail, snack e piatti leggeri serviti comodamente in terrazza.' },
  { icon: 'fa-shower', title: 'Spogliatoi', text: 'Spogliatoi con docce e armadietti.' },
  { icon: 'fa-wifi', title: 'Wi-Fi Gratuito', text: 'Connessione disponibile in tutta l\'area piscina.' },
  { icon: 'fa-square-parking', title: 'Parcheggio', text: 'Area interna (fino esaurimento) e indicazioni di accesso.' },
  { icon: 'fa-wheelchair', title: 'Accessibilità', text: 'Accessi dedicati e percorsi agevolati per tutti.' },
];
---

<section id="servizi" class="bg-sky-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="text-center">
      <div class="text-xs font-semibold tracking-widest text-sky-700">I NOSTRI SERVIZI</div>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">Tutto per il Tuo Comfort</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        Una gamma completa di servizi per rendere la tua giornata in piscina comoda, semplice e indimenticabile.
      </p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7 grid gap-6 sm:grid-cols-2">
        <div class="rounded-3xl overflow-hidden bg-white shadow-sm ring-1 ring-slate-200">
          <div class="aspect-[4/3] bg-slate-200">
            <picture>
              <source srcset="/images/customers/happy-hour.webp" type="image/webp" />
              <img
                src="/images/customers/happy-hour.webp"
                class="h-full w-full object-cover"
                alt="Happy Hour in piscina"
                loading="lazy"
                decoding="async"
                width="700"
                height="525"
              />
            </picture>
          </div>
          <div class="p-6">
            <div class="text-lg font-extrabold text-slate-900">Happy Hour</div>
            <div class="mt-1 text-sm text-slate-600">Ogni giorno 17:00 – 19:00</div>
          </div>
        </div>

        <div class="rounded-3xl overflow-hidden bg-white shadow-sm ring-1 ring-slate-200">
          <div class="p-6">
            <div class="text-lg font-extrabold text-slate-900">Menu Estivo</div>
            <div class="mt-1 text-sm text-slate-600">Piatti freschi e leggeri</div>
          </div>
          <div class="aspect-[4/3] bg-slate-200">
            <picture>
              <source srcset="/images/customers/menu-estivo.webp" type="image/webp" />
              <img
                src="/images/customers/menu-estivo.webp"
                class="h-full w-full object-cover"
                alt="Menu estivo"
                loading="lazy"
                decoding="async"
                width="700"
                height="525"
              />
            </picture>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="space-y-5">
          {services.map((s) => (
            <div class="flex gap-4">
              <div class="mt-1 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
                <i class={`fa-solid ${s.icon} text-xl leading-none`} aria-hidden="true"></i>
              </div>
              <div>
                <div class="font-extrabold text-slate-900">{s.title}</div>
                <div class="mt-1 text-sm text-slate-600">{s.text}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
