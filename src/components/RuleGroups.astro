---
import type { SitePayload } from '@/lib/dto';
import type { RulesContent } from '@/lib/sections';
import CtaButton from '@/components/CtaButton.astro';
import Icon from '@/components/Icon.astro';
import { FALLBACK_COPY } from '@/lib/copy';
import { whatsappUrl } from '@/lib/format';

interface Props {
  id: string;
  site: SitePayload;
  content: RulesContent;
}

const { id, site, content } = Astro.props;
const { eyebrow, title, lead, note, help, groups } = content;
const booking = site.links?.booking ?? null;
const whatsappLink = whatsappUrl(site.contacts?.whatsapp);

const TONES = {
  positive: { bullet: 'bg-green-700', badge: 'bg-green-100 text-green-800' },
  negative: { bullet: 'bg-red-600', badge: 'bg-red-100 text-red-800' },
  neutral: { bullet: 'bg-slate-600', badge: 'bg-slate-100 text-slate-800' },
} as const;
---

<section id={id} class="bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-24 self-start">
        <div class="text-xs font-semibold tracking-widest text-brand-700">{eyebrow}</div>
        <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
          {title}
        </h2>
        <p class="mt-4 text-slate-600">
          {lead}
        </p>

        <div class="mt-8 hidden lg:block rounded-3xl bg-brand-50 p-6 ring-1 ring-brand-100">
          <div class="text-sm font-extrabold text-slate-900">{note.title}</div>
          <p class="mt-2 text-sm text-slate-700">
            {note.text}
          </p>
        </div>

        <div class="mt-6 hidden lg:block rounded-3xl bg-white p-7 shadow-lg ring-1 ring-slate-200">
          <div class="text-lg font-extrabold text-slate-900">{help.title}</div>
          <p class="mt-2 text-sm text-slate-600">
            {help.text}
          </p>

          <div class="mt-6 flex flex-col gap-3">
            {
              whatsappLink && (
                <a
                  href={whatsappLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-2xl bg-cta-700 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-cta-800 transition focus:outline-none focus:ring-2 focus:ring-cta-600/40"
                >
                  <Icon name="fa6-brands:whatsapp" class="text-lg leading-none" />
                  <span>{help.whatsappLabel}</span>
                </a>
              )
            }

            <CtaButton
              link={booking}
              fallbackLabel={FALLBACK_COPY.cta.booking}
              class="inline-flex items-center justify-center rounded-2xl border border-cta-700 px-6 py-3 text-sm font-semibold text-cta-700 hover:bg-cta-50 transition focus:outline-none focus:ring-2 focus:ring-cta-600/20"
            />

            <p class="text-xs text-slate-500">
              {help.footnote}
            </p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid gap-6">
          {
            groups.map((group) => (
              <details open class="group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 [&::-webkit-details-marker]:hidden">
                  <div class="text-lg font-extrabold text-slate-900">{group.title}</div>
                  <div class="flex items-center gap-3">
                    {group.badge && (
                      <span
                        class:list={[
                          'inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold',
                          TONES[group.tone].badge,
                        ]}
                      >
                        {group.badge}
                      </span>
                    )}
                    <svg
                      class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                      stroke="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m19.5 8.25-7.5 7.5-7.5-7.5"
                      />
                    </svg>
                  </div>
                </summary>
                <ul class="mt-4 space-y-3 text-sm text-slate-700">
                  {group.items.map((item) => (
                    <li class="flex gap-3">
                      <span
                        class:list={[
                          'mt-2 h-2 w-2 shrink-0 rounded-full',
                          TONES[group.tone].bullet,
                        ]}
                      />
                      {item}
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }

          <div class="lg:hidden rounded-3xl bg-brand-50 p-6 ring-1 ring-brand-100">
            <div class="text-sm font-extrabold text-slate-900">{note.title}</div>
            <p class="mt-2 text-sm text-slate-700">
              {note.text}
            </p>
          </div>

          <div class="lg:hidden rounded-3xl bg-white p-7 shadow-lg ring-1 ring-slate-200">
            <div class="text-lg font-extrabold text-slate-900">{help.title}</div>
            <p class="mt-2 text-sm text-slate-600">
              {help.text}
            </p>

            <div class="mt-6 flex flex-col gap-3">
              {
                whatsappLink && (
                  <a
                    href={whatsappLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 rounded-2xl bg-cta-700 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-cta-800 transition focus:outline-none focus:ring-2 focus:ring-cta-600/40"
                  >
                    <Icon name="fa6-brands:whatsapp" class="text-lg leading-none" />
                    <span>{help.whatsappLabel}</span>
                  </a>
                )
              }

              <CtaButton
                link={booking}
                fallbackLabel={FALLBACK_COPY.cta.booking}
                class="inline-flex items-center justify-center rounded-2xl border border-cta-700 px-6 py-3 text-sm font-semibold text-cta-700 hover:bg-cta-50 transition focus:outline-none focus:ring-2 focus:ring-cta-600/20"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
