---

<!-- Sticky button per riaprire il banner cookie da qualsiasi pagina pubblica.
     Il listener è condiviso con il link "Modifica preferenze cookie" nel footer
     (entrambi rispondono a [data-action="reset-cookie-consent"]). -->
<button
  type="button"
  data-action="reset-cookie-consent"
  aria-label="Modifica preferenze cookie"
  title="Modifica preferenze cookie"
  class="fixed bottom-4 right-4 z-50 inline-flex h-12 w-12 items-center justify-center rounded-full bg-slate-900 text-white shadow-lg ring-1 ring-white/20 transition hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 md:bottom-6 md:right-6"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-6 w-6"
    aria-hidden="true"
  >
    <path d="M12 2.5a9.5 9.5 0 1 0 9.5 9.5 4 4 0 0 1-4-4 4 4 0 0 1-4-4 1.5 1.5 0 0 1-1.5-1.5z" />
    <circle cx="8" cy="11" r="0.8" fill="currentColor" />
    <circle cx="13.5" cy="14.5" r="0.8" fill="currentColor" />
    <circle cx="9" cy="16" r="0.8" fill="currentColor" />
    <circle cx="15" cy="9" r="0.8" fill="currentColor" />
  </svg>
  <span class="sr-only">Modifica preferenze cookie</span>
</button>
