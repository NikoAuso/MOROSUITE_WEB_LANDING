---
import Icon from '@/components/Icon.astro';
import type { FeaturesContent } from '@/lib/sections';

interface Props {
  id: string;
  content: FeaturesContent;
}

const { id, content } = Astro.props;
const { eyebrow, title, lead, items: features, stats } = content;
---

<section id={id} class="bg-brand-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="text-center">
      <div class="text-xs font-semibold tracking-widest text-brand-700">{eyebrow}</div>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
        {title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        {lead}
      </p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f) => (
          <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
              <Icon name={f.icon} />
            </div>
            <div class="mt-4 text-lg font-bold">{f.title}</div>
            <p class="mt-2 text-sm text-slate-600">{f.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-14 grid gap-8 text-center md:grid-cols-4" id={`${id}-stats`}>
      {
        stats.map((s) => (
          <div>
            <div
              class="text-4xl font-extrabold tracking-tight text-brand-700"
              data-count-up
              data-target={s.target}
              data-decimals={s.decimals}
              data-prefix={s.prefix ?? ''}
              data-suffix={s.suffix}
            >
              {s.prefix ?? ''}
              {s.target}
              {s.suffix}
            </div>
            <div class="mt-2 text-xs font-semibold tracking-widest text-slate-700">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const els = document.querySelectorAll<HTMLElement>('[data-count-up]');
  if (els.length > 0 && 'IntersectionObserver' in window) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const formatNumber = (value: number, decimals: number): string =>
      decimals === 0
        ? Math.round(value).toLocaleString('it-IT')
        : value.toLocaleString('it-IT', {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
          });

    const animate = (el: HTMLElement): void => {
      const target = Number(el.dataset.target ?? '0');
      const decimals = Number(el.dataset.decimals ?? '0');
      const prefix = el.dataset.prefix ?? '';
      const suffix = el.dataset.suffix ?? '';

      if (reduce) {
        el.textContent = `${prefix}${formatNumber(target, decimals)}${suffix}`;
        return;
      }

      const duration = 1400;
      const start = performance.now();

      const tick = (now: number): void => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = `${prefix}${formatNumber(target * eased, decimals)}${suffix}`;
        if (t < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 },
    );

    els.forEach((el) => observer.observe(el));
  }
</script>
