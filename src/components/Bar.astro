---
import type { SitePayload } from '@/lib/dto';
import CtaButton from '@/components/CtaButton.astro';
import { FALLBACK_COPY } from '@/lib/copy';

interface Props {
  site: SitePayload;
}

const { site } = Astro.props;
const booking = site.links?.booking ?? null;

const sections = [
  { title: 'Caffetteria', text: 'Caffè, cappuccini, cornetti, succhi, gelati.' },
  { title: 'Snack e pranzi', text: 'Panini, insalate, piatti del giorno e opzioni per bambini.' },
  { title: 'Drink e aperitivi', text: 'Cocktail, analcolici, birre e aperitivi al tramonto.' },
];
---

<section id="bar" class="bg-sky-900 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <h2 class="text-3xl font-extrabold tracking-tight">Bar in piscina</h2>
        <p class="mt-4 text-white/80">
          Caffetteria, snack, pranzi leggeri e aperitivi: perfetto per una pausa durante la
          giornata.
        </p>

        <div class="mt-6 grid gap-3">
          {
            sections.map((s) => (
              <div class="group rounded-2xl bg-white/10 p-4">
                <div class="font-semibold flex items-center justify-between">{s.title}</div>
                <p class="mt-2 text-sm text-white/80">{s.text}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <CtaButton
            link={booking}
            fallbackLabel={FALLBACK_COPY.cta.booking}
            class="inline-flex items-center justify-center rounded-2xl bg-green-700 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-green-800 transition"
          />
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="overflow-hidden rounded-3xl bg-white/10">
            <img
              class="h-56 w-full object-cover"
              loading="lazy"
              decoding="async"
              src="https://picsum.photos/seed/cocktails/600/400"
              width="600"
              height="400"
              alt="Drink al bar"
            />
          </div>
          <div class="overflow-hidden rounded-3xl bg-white/10">
            <img
              class="h-56 w-full object-cover"
              loading="lazy"
              decoding="async"
              src="https://picsum.photos/seed/snack/600/400"
              width="600"
              height="400"
              alt="Snack"
            />
          </div>
          <div class="sm:col-span-2 overflow-hidden rounded-3xl bg-white/10">
            <img
              class="h-56 w-full object-cover"
              loading="lazy"
              decoding="async"
              src="https://picsum.photos/seed/terrace/1200/400"
              width="1200"
              height="400"
              alt="Solarium terrazza"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
