---
import type { GalleryContent } from '@/lib/sections';

interface Props {
  id: string;
  content: GalleryContent;
}

const { id, content } = Astro.props;
const { eyebrow, title, lead, images } = content;
const hasHeading = Boolean(eyebrow || title || lead);
---

<section id={id} class="bg-brand-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    {
      hasHeading && (
        <div class="text-center">
          {eyebrow && (
            <div class="text-xs font-semibold tracking-widest text-brand-700">{eyebrow}</div>
          )}
          {title && (
            <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">{title}</h2>
          )}
          {lead && <p class="mx-auto mt-4 max-w-2xl text-slate-600">{lead}</p>}
        </div>
      )
    }

    <div class:list={['grid gap-6 sm:grid-cols-2 lg:grid-cols-3', hasHeading && 'mt-14']}>
      {
        images.map((image) => (
          <figure
            class:list={[
              // flex-col + grow sull'area immagine: quando la riga di grid si
              // stira all'altezza di una card con didascalia, è la foto ad
              // assorbire lo spazio extra, non un vuoto bianco in fondo.
              'flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200',
              image.wide && 'sm:col-span-2',
            ]}
          >
            <div class="aspect-[4/3] grow bg-slate-200">
              <img
                src={image.src}
                alt={image.alt}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
            {image.caption && (
              <figcaption class="p-4 text-sm text-slate-600">{image.caption}</figcaption>
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>
