---
import type { PricingPayload, SitePayload } from '@/lib/dto';
import ErrorState from '@/components/ErrorState.astro';
import CtaButton from '@/components/CtaButton.astro';
import Icon from '@/components/Icon.astro';
import { FALLBACK_COPY } from '@/lib/copy';
import { visiblePricingSections, formatPrice, countRows } from '@/lib/pricing';
import { whatsappUrl } from '@/lib/format';

interface Props {
  pricing: PricingPayload | null;
  site: SitePayload;
}

const { pricing, site } = Astro.props;
const entranceSections = pricing ? visiblePricingSections(pricing.entrance_sections) : [];
const passSections = pricing ? visiblePricingSections(pricing.pass_sections) : [];
const entranceCount = countRows(entranceSections);
const passCount = countRows(passSections);
const booking = site.links?.booking ?? null;
const whatsappLink = whatsappUrl(site.contacts?.whatsapp);
---

<section id="prezzi" class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-6 lg:sticky lg:top-24 self-start">
        <div class="text-xs font-semibold tracking-widest text-sky-700">PREZZI ATTIVI</div>
        <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
          Tariffe aggiornate in tempo reale
        </h2>
        <p class="mt-4 text-slate-600">
          I prezzi variano in base a data, fascia oraria e tipologia di ingresso. Trovi sempre il
          listino attivo durante la prenotazione.
        </p>
        <p class="mt-3 text-md font-semibold text-slate-600">
          Tutti i prezzi si intendono a persona.
        </p>
        <p class="mt-3 rounded-2xl bg-sky-50 px-4 py-3 text-sm text-slate-700 ring-1 ring-sky-100">
          Le persone con disabilità in possesso di certificazione INPS valida hanno diritto alla
          riduzione del 50% sul biglietto di ingresso individuale. L'agevolazione è riconosciuta al
          titolare previa presentazione della certificazione e di un documento di identità in cassa.
          Gli accompagnatori pagano il biglietto intero. La riduzione è non cumulabile con altre
          promozioni e non si applica ad abbonamenti o servizi aggiuntivi.
        </p>
        <div class="my-6 flex flex-wrap items-center gap-3">
          <CtaButton
            link={booking}
            fallbackLabel={FALLBACK_COPY.cta.booking}
            class="inline-flex items-center justify-center rounded-2xl bg-green-700 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-green-800 transition"
          />
          {
            whatsappLink && (
              <a
                href={whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-2xl border border-slate-200 px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition"
              >
                Chiedi info
              </a>
            )
          }
        </div>
      </div>

      <div class="lg:col-span-6">
        {
          pricing ? (
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
              <div class="flex items-center gap-3">
                <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-100 text-sky-700">
                  <Icon name="fa6-solid:ticket" />
                </div>
                <div>
                  <div class="text-lg font-extrabold text-slate-900">
                    {pricing.active_price_list_name}
                  </div>
                  <div class="text-sm text-slate-600">Sempre allineato alle disponibilità.</div>
                </div>
              </div>

              <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-2">
                <div class="grid grid-cols-2 gap-2 text-sm font-semibold">
                  <button
                    type="button"
                    class="price-tab rounded-xl px-3 py-2 text-slate-700 hover:bg-slate-50"
                    data-tab-target="entrance"
                  >
                    Ingressi ({entranceCount})
                  </button>
                  <button
                    type="button"
                    class="price-tab rounded-xl px-3 py-2 text-slate-700 hover:bg-slate-50"
                    data-tab-target="pass"
                  >
                    Abbonamenti ({passCount})
                  </button>
                </div>
              </div>

              <div class="mt-4">
                <div class="price-tab-panel grid gap-4 text-sm text-slate-700" data-tab="entrance">
                  {entranceSections.length > 0 ? (
                    entranceSections.map((section) => (
                      <div class="space-y-3">
                        <div class="text-xs font-semibold uppercase tracking-widest text-slate-500">
                          {section.label}
                        </div>
                        <div class="rounded-2xl bg-white ring-1 ring-slate-200">
                          <div class="grid grid-cols-3 text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                            <div class="px-4 py-2">Fascia età</div>
                            <div class="px-4 py-2 text-right">Feriali</div>
                            <div class="px-4 py-2 text-right">Festivi</div>
                          </div>
                          {section.rows.map((row) => (
                            <div class="grid grid-cols-3 border-t border-slate-100 text-sm">
                              <div class="px-4 py-3 font-semibold text-slate-900">
                                <div>{row.label}</div>
                                {row.range && (
                                  <div class="text-xs font-normal text-slate-500">{row.range}</div>
                                )}
                              </div>
                              <div class="px-4 py-3 text-right font-extrabold text-slate-900 flex items-center justify-end">
                                {row.weekday_value === null && !row.weekday_is_free ? (
                                  <span class="text-slate-400">—</span>
                                ) : (
                                  formatPrice(row.weekday_value, row.weekday_is_free)
                                )}
                              </div>
                              <div class="px-4 py-3 text-right font-extrabold text-slate-900 flex items-center justify-end">
                                {row.weekend_value === null && !row.weekend_is_free ? (
                                  <span class="text-slate-400">—</span>
                                ) : (
                                  formatPrice(row.weekend_value, row.weekend_is_free)
                                )}
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    ))
                  ) : (
                    <div class="rounded-2xl bg-white px-4 py-3 ring-1 ring-slate-200">
                      Nessun ingresso disponibile al momento.
                    </div>
                  )}
                </div>

                <div class="price-tab-panel hidden gap-4 text-sm text-slate-700" data-tab="pass">
                  {passSections.length > 0 ? (
                    passSections.map((section) => (
                      <div class="space-y-3">
                        <div class="text-xs font-semibold uppercase tracking-widest text-slate-500">
                          {section.label}
                        </div>
                        <div class="rounded-2xl bg-white ring-1 ring-slate-200">
                          <div class="grid grid-cols-2 text-[11px] font-semibold uppercase tracking-widest text-slate-500">
                            <div class="px-4 py-2">Fascia età</div>
                            <div class="px-4 py-2 text-right">Prezzo</div>
                          </div>
                          {section.rows.map((row) => (
                            <div class="grid grid-cols-2 border-t border-slate-100 text-sm">
                              <div class="px-4 py-3 font-semibold text-slate-900">
                                <div>{row.label}</div>
                                {row.range && (
                                  <div class="text-xs font-normal text-slate-500">{row.range}</div>
                                )}
                                {!section.allows_umbrella_booking && (
                                  <span class="text-slate-500 font-normal">
                                    (ombrellone non prenotabile)
                                  </span>
                                )}
                              </div>
                              <div class="px-4 py-3 text-right font-extrabold text-slate-900 flex items-center justify-end">
                                {row.value === null && !row.is_free ? (
                                  <span class="text-slate-400">—</span>
                                ) : (
                                  formatPrice(row.value, row.is_free)
                                )}
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    ))
                  ) : (
                    <div class="rounded-2xl bg-white px-4 py-3 ring-1 ring-slate-200">
                      Nessun abbonamento disponibile al momento.
                    </div>
                  )}
                </div>
              </div>
            </div>
          ) : (
            <ErrorState
              code={FALLBACK_COPY.pricing.badge}
              title={FALLBACK_COPY.pricing.title}
              description={FALLBACK_COPY.pricing.description}
              ctaHref="#regolamento"
              ctaLabel="Vai al regolamento"
            />
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.price-tab');
  const panels = document.querySelectorAll<HTMLElement>('.price-tab-panel');

  const activate = (target: string): void => {
    tabs.forEach((tab) => {
      const active = tab.dataset.tabTarget === target;
      tab.classList.toggle('bg-sky-100', active);
      tab.classList.toggle('text-sky-900', active);
      tab.classList.toggle('text-slate-700', !active);
    });
    panels.forEach((panel) => {
      const active = panel.dataset.tab === target;
      panel.classList.toggle('hidden', !active);
      panel.classList.toggle('grid', active);
    });
  };

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => activate(tab.dataset.tabTarget ?? 'entrance'));
  });

  activate('entrance');
</script>
