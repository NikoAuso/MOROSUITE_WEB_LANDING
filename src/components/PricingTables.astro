---
import type { PricingPayload } from '@/lib/types';

interface Props {
  pricing: PricingPayload;
}

const { pricing } = Astro.props;

const formatValue = (v: number | null, isFree: boolean): string => {
  if (isFree) return 'Gratis';
  if (v === null) return '—';
  return v.toLocaleString('it-IT', { style: 'currency', currency: 'EUR' });
};
---

<section id="prezzi" class="mx-auto max-w-4xl px-4 py-16">
  <h2 class="text-2xl font-bold">Prezzi</h2>

  {
    !pricing.has_prices ? (
      <p class="mt-6 text-slate-600">Listino non ancora pubblicato.</p>
    ) : (
      <>
        {pricing.entrance_sections.length > 0 && (
          <div class="mt-8">
            <h3 class="text-lg font-semibold">Ingressi</h3>
            {pricing.entrance_sections.map((section) => (
              <div class="mt-4 overflow-x-auto">
                <h4 class="text-sm font-semibold text-slate-700">{section.label}</h4>
                <table class="mt-2 w-full border-collapse text-sm">
                  <thead>
                    <tr class="bg-slate-50 text-left">
                      <th class="border-b border-slate-200 px-3 py-2">Fascia</th>
                      <th class="border-b border-slate-200 px-3 py-2">Settimana</th>
                      <th class="border-b border-slate-200 px-3 py-2">Weekend</th>
                    </tr>
                  </thead>
                  <tbody>
                    {section.rows.map((row) => (
                      <tr>
                        <td class="border-b border-slate-100 px-3 py-2">
                          {row.label}
                          {row.range ? ` · ${row.range}` : ''}
                        </td>
                        <td class="border-b border-slate-100 px-3 py-2">
                          {formatValue(row.weekday_value, row.weekday_is_free)}
                        </td>
                        <td class="border-b border-slate-100 px-3 py-2">
                          {formatValue(row.weekend_value, row.weekend_is_free)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
        )}

        {pricing.pass_sections.length > 0 && (
          <div class="mt-12">
            <h3 class="text-lg font-semibold">Abbonamenti</h3>
            {pricing.pass_sections.map((section) => (
              <div class="mt-4 overflow-x-auto">
                <h4 class="text-sm font-semibold text-slate-700">{section.label}</h4>
                <table class="mt-2 w-full border-collapse text-sm">
                  <thead>
                    <tr class="bg-slate-50 text-left">
                      <th class="border-b border-slate-200 px-3 py-2">Fascia</th>
                      <th class="border-b border-slate-200 px-3 py-2">Prezzo</th>
                    </tr>
                  </thead>
                  <tbody>
                    {section.rows.map((row) => (
                      <tr>
                        <td class="border-b border-slate-100 px-3 py-2">
                          {row.label}
                          {row.range ? ` · ${row.range}` : ''}
                        </td>
                        <td class="border-b border-slate-100 px-3 py-2">
                          {formatValue(row.value, row.is_free)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
        )}
      </>
    )
  }
</section>
