---
import { PRIMARY_NAV, FOOTER_NAV } from '@/lib/navigation';
import { config } from '@/lib/config';
---

<section class="mx-auto max-w-4xl px-4 py-16">
  <h2 class="text-2xl font-bold">Mappa del sito</h2>

  <div class="mt-8 grid gap-8 md:grid-cols-3">
    <div>
      <h3 class="text-lg font-semibold">Sito principale</h3>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a href="/" class="hover:underline">Home</a></li>
        {
          PRIMARY_NAV.map((e) => (
            <li>
              <a href={e.href} class="hover:underline">
                {e.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-lg font-semibold">Documenti legali</h3>
      <ul class="mt-2 space-y-1 text-sm">
        {
          FOOTER_NAV.map((e) => (
            <li>
              <a href={e.href} class="hover:underline">
                {e.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-lg font-semibold">Area riservata</h3>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a href={`${config.coreAppUrl}/login`} class="hover:underline">Accesso clienti</a></li>
        <li><a href={`${config.coreAppUrl}/register`} class="hover:underline">Registrazione</a></li>
      </ul>
    </div>
  </div>
</section>
