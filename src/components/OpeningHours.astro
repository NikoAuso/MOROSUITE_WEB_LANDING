---
import type { OpeningHoursPayload } from '@/lib/types';

interface Props {
  hours: OpeningHoursPayload;
}

const { hours } = Astro.props;

const todayKey = ((): string => {
  const d = new Date().toLocaleDateString('en-US', { weekday: 'long', timeZone: hours.timezone });
  return d.toLowerCase();
})();
---

<section id="orari" class="mx-auto max-w-4xl px-4 py-16">
  <h2 class="text-2xl font-bold">Orari di apertura</h2>
  <p class="mt-2 text-sm text-slate-500">Fuso orario: {hours.timezone}</p>

  {
    hours.daily_hours === null ? (
      <p class="mt-6 text-slate-600">Orari non ancora disponibili.</p>
    ) : (
      <table class="mt-6 w-full border-collapse">
        <tbody>
          {hours.daily_hours.map((row) => (
            <tr class={row.key === todayKey ? 'bg-brand-accent/10 font-semibold' : ''}>
              <td class="border-b border-slate-200 px-3 py-3 text-sm capitalize">{row.label}</td>
              <td class="border-b border-slate-200 px-3 py-3 text-sm">
                {row.closed ? (
                  <span class="text-slate-400">Chiuso</span>
                ) : (
                  row.intervals.map((i) => `${i.label}: ${i.open}–${i.close}`).join(' · ')
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</section>
