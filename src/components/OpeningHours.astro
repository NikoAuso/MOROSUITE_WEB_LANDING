---
import type { SitePayload, OpeningHoursPayload } from '@/lib/dto';
import type { HoursContent, FallbackCta } from '@/lib/sections';
import ErrorState from '@/components/ErrorState.astro';
import { FALLBACK_COPY } from '@/lib/copy';
import { formatSeasonDate } from '@/lib/format';

interface Props {
  id: string;
  hours: OpeningHoursPayload | null;
  site: SitePayload;
  content: HoursContent;
  fallbackCta?: FallbackCta;
}

const { id, hours, site, content, fallbackCta } = Astro.props;

const seasonCards = [
  { label: 'Inizio stagione', value: formatSeasonDate(site.season.start_date) },
  { label: 'Fine stagione', value: formatSeasonDate(site.season.end_date) },
].filter((card): card is { label: string; value: string } => card.value !== null);

let todayKey = '';
if (hours) {
  try {
    todayKey = new Date()
      .toLocaleDateString('en-US', { weekday: 'long', timeZone: hours.timezone })
      .toLowerCase();
  } catch {
    // A malformed IANA timezone from the backend throws RangeError here. Skip
    // the "Oggi" highlight rather than crashing the whole page render.
  }
}
---

{
  hours ? (
    <section id={id} class="bg-white">
      <div class="mx-auto max-w-7xl px-4 py-25 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="text-xs font-semibold tracking-widest text-sky-700">{content.eyebrow}</div>
          <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
            {content.title}
          </h2>
        </div>

        {seasonCards.length > 0 && (
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {seasonCards.map((card) => (
              <div class="rounded-2xl bg-sky-50 p-5 text-center shadow-sm ring-1 ring-sky-200">
                <div class="text-xs font-semibold uppercase tracking-widest text-sky-700">
                  {card.label}
                </div>
                <div class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900">
                  {card.value}
                </div>
              </div>
            ))}
          </div>
        )}

        <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-4 lg:grid-cols-7">
          {hours.daily_hours!.map((day) => {
            const isToday = day.key === todayKey;
            return (
              <div class="relative pt-3">
                {isToday && (
                  <div class="absolute left-0 right-0 top-0 flex justify-center">
                    <span class="rounded-full bg-sky-700 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-white shadow-sm">
                      Oggi
                    </span>
                  </div>
                )}

                <div
                  class:list={[
                    'flex flex-col items-center rounded-2xl p-5 text-center ring-1 transition-shadow',
                    isToday
                      ? 'bg-sky-100 ring-2 ring-sky-500 shadow-md'
                      : 'bg-slate-50 ring-slate-200',
                  ]}
                >
                  <div
                    class:list={[
                      'text-xs font-semibold uppercase tracking-widest',
                      isToday ? 'text-sky-700' : 'text-slate-500',
                    ]}
                  >
                    {day.label}
                  </div>

                  {day.closed ? (
                    <div class="mt-3 text-sm font-medium text-slate-500">Chiuso</div>
                  ) : (
                    <div class="mt-3 flex w-full flex-col gap-2">
                      {day.intervals.map((interval) => (
                        <div
                          class:list={[
                            'rounded-xl px-3 py-2 text-sm font-bold ring-1',
                            isToday
                              ? 'bg-white/80 text-sky-900 ring-sky-200'
                              : 'bg-white text-slate-800 ring-slate-200',
                          ]}
                        >
                          <div class="flex flex-col items-center gap-0.5">
                            <span class="text-xs font-medium">{interval.label}</span>
                            <span>
                              {interval.open} – {interval.close}
                            </span>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  ) : (
    <section id={id}>
      <ErrorState
        code={FALLBACK_COPY.hours.badge}
        title={FALLBACK_COPY.hours.title}
        description={FALLBACK_COPY.hours.description}
        ctaHref={fallbackCta?.href}
        ctaLabel={fallbackCta?.label}
      />
    </section>
  )
}
