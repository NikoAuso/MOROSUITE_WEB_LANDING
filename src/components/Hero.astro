---
import type { SitePayload } from '@/lib/dto';
import type { HeroContent } from '@/lib/sections';
import CtaButton from '@/components/CtaButton.astro';
import Icon from '@/components/Icon.astro';
import { FALLBACK_COPY } from '@/lib/copy';

interface Props {
  site: SitePayload;
  content: HeroContent;
}

const { site, content } = Astro.props;
const { title, highlight, lead, secondaryCta, card } = content;
// All items iconed = bullet list; otherwise numbered steps with arrows.
const asList = card?.items.every((item) => item.icon) ?? false;
const booking = site.links?.booking ?? null;
---

<!-- Hero -->
<section class="relative overflow-hidden min-h-[calc(100vh-64px)]">
  <div class="absolute inset-0">
    <div class="h-full w-full bg-linear-to-b from-brand-950 via-brand-900 to-brand-800"></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_20%_10%,var(--hero-glow-a),transparent_55%),radial-gradient(circle_at_80%_15%,var(--hero-glow-b),transparent_50%)]"
    >
    </div>
    {
      content.image && (
        <img
          src={content.image.src}
          alt=""
          class="absolute inset-0 h-full w-full object-cover opacity-40"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-full">
    <div class="grid min-h-[calc(100vh-64px)] place-items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-white sm:text-6xl">
          {title}
          <span class="block text-brand-200 text-shadow-lg">{highlight}</span>
        </h1>
        <p class="mt-4 max-w-2xl text-base text-white sm:text-lg">
          {lead}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <CtaButton
            link={booking}
            fallbackLabel={FALLBACK_COPY.cta.booking}
            class="inline-flex items-center justify-center rounded-2xl bg-cta-700 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-cta-800 transition"
          />
          {
            secondaryCta && (
              <a
                href={secondaryCta.href}
                class="inline-flex items-center justify-center rounded-2xl bg-slate-900/40 px-6 py-3 text-sm font-semibold text-white ring-1 ring-white/60 hover:bg-slate-900/60 transition"
              >
                {secondaryCta.label}
              </a>
            )
          }
        </div>
      </div>

      <!-- Right card (optional: omit `card` for a copy-only hero) -->
      {
        card && (
          <div class="lg:col-span-4 py-14">
            <div class="rounded-3xl bg-accent-50/95 p-6 shadow-xl border-2 border-accent-200">
              <div class="flex items-center justify-center gap-4">
                <div>
                  <h2 class="text-lg font-bold">{card.title}</h2>
                  {card.subtitle && <p class="mt-1 text-sm text-slate-600">{card.subtitle}</p>}
                </div>
              </div>

              <div class="mt-6 grid gap-3">
                {card.items.map((item, index) => (
                  <>
                    {!asList && index > 0 && (
                      <div class="flex justify-center text-accent-500">
                        <Icon name="fa6-solid:angle-down" class="animate-bounce" />
                      </div>
                    )}
                    <div class="flex gap-4 rounded-2xl border border-accent-200 bg-white p-4">
                      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-400 font-bold text-gray-900">
                        {item.icon ? <Icon name={item.icon} class="size-5" /> : index + 1}
                      </div>
                      <div>
                        <div class="font-semibold">{item.title}</div>
                        <div class="text-sm text-slate-600">{item.text}</div>
                      </div>
                    </div>
                  </>
                ))}
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
