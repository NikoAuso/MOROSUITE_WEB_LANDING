---
import { config } from '@/lib/config';
import { PRIMARY_NAV } from '@/lib/navigation';
import type { SitePayload } from '@/lib/dto';
import CtaButton from '@/components/CtaButton.astro';
import Icon from '@/components/Icon.astro';
import { FALLBACK_COPY } from '@/lib/copy';
import { safeHref } from '@/lib/format';

interface Props {
  site: SitePayload;
  showNav?: boolean;
}

const { site, showNav = true } = Astro.props;
const hotel = site.links?.hotel ?? null;
const booking = site.links?.booking ?? null;
const hotelHref = hotel ? safeHref(hotel.url) : null;
---

<header class="sticky top-0 z-50 bg-sky-900/90 backdrop-blur border-b border-white/10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-3 text-white">
          <div class="flex size-11 items-center justify-center rounded-lg overflow-hidden">
            <img
              src={config.brand.logoUrl}
              alt={site.name ?? 'Logo'}
              class="h-full w-full object-contain"
            />
          </div>
          <span class="hidden text-lg font-extrabold sm:inline">{site.short_name ?? site.name}</span
          >
        </a>
      </div>

      {
        showNav && (
          <nav class="hidden md:flex items-center gap-6 text-md font-semibold text-white/80">
            {PRIMARY_NAV.map((link) => (
              <a href={link.href} class="hover:text-white transition">
                {link.label}
              </a>
            ))}
          </nav>
        )
      }

      <div class="flex items-center gap-2">
        {
          showNav && (
            <button
              type="button"
              data-mobile-menu-toggle
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-white/20 text-white transition hover:bg-white/10 md:hidden"
              aria-label="Apri menu di navigazione"
              aria-expanded="false"
            >
              <Icon name="fa6-solid:bars" data-mobile-menu-open-icon class="text-base" />
              <Icon name="fa6-solid:xmark" data-mobile-menu-close-icon class="text-base" hidden />
            </button>
          )
        }

        <CtaButton
          link={hotel}
          fallbackLabel=""
          hideWhenMissing={true}
          external={true}
          class="hidden sm:inline-flex items-center justify-center rounded-xl border border-white/30 px-4 py-2 text-sm font-semibold text-white/90 hover:bg-white/10 transition"
        />

        <CtaButton
          link={booking}
          fallbackLabel={FALLBACK_COPY.cta.booking}
          class="inline-flex items-center justify-center rounded-xl bg-green-700 px-4 py-2 text-sm font-semibold text-white shadow-lg hover:bg-green-800 transition"
        />
      </div>
    </div>
  </div>

  {
    showNav && (
      <div
        data-mobile-menu
        class="absolute inset-x-0 top-full border-t border-white/10 bg-sky-900/95 shadow-2xl backdrop-blur md:hidden"
        hidden
      >
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
          <nav class="grid gap-2 text-sm font-semibold text-white">
            {PRIMARY_NAV.map((link) => (
              <a
                href={link.href}
                data-mobile-menu-link
                class="rounded-xl px-4 py-3 transition hover:bg-white/10"
              >
                {link.label}
              </a>
            ))}
            {hotel && hotelHref && (
              <a
                href={hotelHref}
                target="_blank"
                rel="noopener noreferrer"
                data-mobile-menu-link
                class="rounded-xl px-4 py-3 transition hover:bg-white/10"
              >
                {hotel.label}
              </a>
            )}
          </nav>
        </div>
      </div>
    )
  }
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const openIcon = document.querySelector<HTMLElement>('[data-mobile-menu-open-icon]');
  const closeIcon = document.querySelector<HTMLElement>('[data-mobile-menu-close-icon]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-menu-link]');

  function setMenuOpen(open: boolean): void {
    if (!toggle || !menu || !openIcon || !closeIcon) return;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) {
      menu.removeAttribute('hidden');
      openIcon.setAttribute('hidden', '');
      closeIcon.removeAttribute('hidden');
    } else {
      menu.setAttribute('hidden', '');
      closeIcon.setAttribute('hidden', '');
      openIcon.removeAttribute('hidden');
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  links.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
</script>
