---
import type { SitePayload } from '@/lib/dto';
import type { RoomsContent } from '@/lib/sections';
import CtaButton from '@/components/CtaButton.astro';
import { FALLBACK_COPY } from '@/lib/copy';

interface Props {
  id: string;
  site: SitePayload;
  content: RoomsContent;
}

const { id, site, content } = Astro.props;
const { eyebrow, title, lead, footnote, items } = content;
const booking = site.links?.booking ?? null;
---

<section id={id} class="bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="text-center">
      <div class="text-xs font-semibold tracking-widest text-brand-700">{eyebrow}</div>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">{title}</h2>
      {lead && <p class="mx-auto mt-4 max-w-2xl text-slate-600">{lead}</p>}
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        items.map((room) => (
          <article class="flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200">
            <div class="aspect-[4/3] bg-slate-200">
              <img
                src={room.image.src}
                alt={room.image.alt}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
                width="700"
                height="525"
              />
            </div>
            <div class="flex grow flex-col p-6">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-extrabold text-slate-900">{room.name}</h3>
                {room.price && (
                  <div class="shrink-0 rounded-full bg-accent-50 px-3 py-1 text-sm font-bold text-slate-900 ring-1 ring-accent-200">
                    {room.price}
                  </div>
                )}
              </div>
              <p class="mt-2 grow text-sm text-slate-600">{room.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {room.facts.map((fact) => (
                  <li class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-800">
                    {fact}
                  </li>
                ))}
              </ul>
              <CtaButton
                link={booking}
                fallbackLabel={FALLBACK_COPY.cta.booking}
                class="mt-6 inline-flex items-center justify-center rounded-2xl bg-cta-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-cta-800 transition"
              />
            </div>
          </article>
        ))
      }
    </div>

    {footnote && <p class="mt-8 text-center text-xs text-slate-500">{footnote}</p>}
  </div>
</section>
