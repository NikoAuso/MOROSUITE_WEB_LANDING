---
import Icon from '@/components/Icon.astro';
import type { MenuContent } from '@/lib/sections';
import { menuGroups } from '@/lib/sections';

interface Props {
  id: string;
  content: MenuContent;
}

const { id, content } = Astro.props;
const { eyebrow, title, lead, footnote, externalCta, courses } = content;

// Tabs appear only when the author asked for them.
const groups = menuGroups(courses);
const tabs = groups.map((group) => group.tab).filter(Boolean) as string[];
---

<section id={id} class="bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="text-center">
      <div class="text-xs font-semibold tracking-widest text-brand-700">{eyebrow}</div>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
        {title}
      </h2>
      {lead && <p class="mx-auto mt-4 max-w-2xl text-slate-600">{lead}</p>}
    </div>

    <div class="mx-auto mt-12 max-w-4xl" data-menu>
      {
        tabs.length > 1 && (
          <div
            class="flex flex-wrap justify-center gap-2 rounded-full bg-brand-50 p-2"
            role="tablist"
            data-menu-tablist
            hidden
          >
            {tabs.map((tab, index) => (
              <button
                type="button"
                role="tab"
                data-menu-tab={tab}
                aria-selected={index === 0 ? 'true' : 'false'}
                class="rounded-full px-5 py-2 text-sm font-semibold text-brand-800 transition aria-selected:bg-brand-700 aria-selected:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
              >
                {tab}
              </button>
            ))}
          </div>
        )
      }

      {
        groups.map((group, groupIndex) => (
          <div
            class="mt-8 grid gap-4"
            data-menu-panel={group.tab}
            role={group.tab ? 'tabpanel' : undefined}
          >
            {group.courses.map((course, index) => (
              <details
                class="group rounded-3xl bg-white shadow-sm ring-1 ring-slate-200 open:ring-brand-200"
                open={groupIndex === 0 && index === 0}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-3xl p-6 text-xs font-semibold uppercase tracking-widest text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 [&::-webkit-details-marker]:hidden">
                  {course.label}
                  <Icon
                    name="fa6-solid:chevron-down"
                    class="shrink-0 text-brand-700 transition group-open:rotate-180"
                  />
                </summary>
                <ul class="space-y-5 px-6 pb-6">
                  {course.dishes.map((dish) => (
                    <li class="flex items-baseline gap-3">
                      <div class="min-w-0">
                        <div class="font-extrabold text-slate-900">{dish.name}</div>
                        {dish.description && (
                          <p class="mt-1 text-sm text-slate-600">{dish.description}</p>
                        )}
                      </div>
                      {dish.price && (
                        <>
                          <span
                            class="mx-1 grow border-b border-dotted border-slate-300"
                            aria-hidden="true"
                          />
                          <span class="shrink-0 font-extrabold text-slate-900">{dish.price}</span>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        ))
      }
    </div>

    {
      externalCta && (
        <div class="mt-10 text-center">
          <a
            href={externalCta.href}
            class="inline-flex items-center gap-2 rounded-2xl bg-cta-700 px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-cta-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500"
          >
            {externalCta.label}
            <Icon name="fa6-solid:arrow-up-right-from-square" class="size-4" />
          </a>
        </div>
      )
    }

    {
      footnote && (
        <p class="mx-auto mt-8 max-w-4xl text-center text-xs text-slate-500">{footnote}</p>
      )
    }
  </div>
</section>

{
  /* Tabs are progressive enhancement: the tablist ships hidden and every panel
    visible, so with JS off the whole menu is still readable. */
}
<script>
  for (const menu of document.querySelectorAll<HTMLElement>('[data-menu]')) {
    const tablist = menu.querySelector<HTMLElement>('[data-menu-tablist]');
    if (!tablist) continue;
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[data-menu-tab]')];
    const panels = [...menu.querySelectorAll<HTMLElement>('[data-menu-panel]')];

    const select = (name: string) => {
      for (const tab of tabs) {
        tab.setAttribute('aria-selected', String(tab.dataset.menuTab === name));
      }
      for (const panel of panels) {
        panel.hidden = panel.dataset.menuPanel !== name;
      }
    };

    tablist.hidden = false;
    for (const tab of tabs) {
      tab.addEventListener('click', () => select(tab.dataset.menuTab!));
    }
    if (tabs[0]?.dataset.menuTab) select(tabs[0].dataset.menuTab);
  }
</script>
