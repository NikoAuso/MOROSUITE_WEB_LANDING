---
import type { MenuContent } from '@/lib/sections';

interface Props {
  id: string;
  content: MenuContent;
}

const { id, content } = Astro.props;
const { eyebrow, title, lead, footnote, courses } = content;
---

<section id={id} class="bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="text-center">
      <div class="text-xs font-semibold tracking-widest text-brand-700">{eyebrow}</div>
      <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">
        {title}
      </h2>
      {lead && <p class="mx-auto mt-4 max-w-2xl text-slate-600">{lead}</p>}
    </div>

    <div class="mx-auto mt-14 grid max-w-4xl gap-8">
      {
        courses.map((course) => (
          <div class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
            <div class="text-xs font-semibold uppercase tracking-widest text-brand-700">
              {course.label}
            </div>
            <ul class="mt-5 space-y-5">
              {course.dishes.map((dish) => (
                <li class="flex items-baseline gap-3">
                  <div class="min-w-0">
                    <div class="font-extrabold text-slate-900">{dish.name}</div>
                    {dish.description && (
                      <p class="mt-1 text-sm text-slate-600">{dish.description}</p>
                    )}
                  </div>
                  {dish.price && (
                    <>
                      <span
                        class="mx-1 grow border-b border-dotted border-slate-300"
                        aria-hidden="true"
                      />
                      <span class="shrink-0 font-extrabold text-slate-900">{dish.price}</span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {
      footnote && (
        <p class="mx-auto mt-8 max-w-4xl text-center text-xs text-slate-500">{footnote}</p>
      )
    }
  </div>
</section>
