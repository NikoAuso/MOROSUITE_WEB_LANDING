---
import { FOOTER_NAV } from '@/lib/navigation';
import type { FacilityPayload } from '@/lib/types';

interface Props {
  facility: FacilityPayload;
}

const { facility } = Astro.props;
---

<footer class="bg-slate-900 text-slate-200">
  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-8 md:grid-cols-3">
    <div>
      <h3 class="text-lg font-semibold text-white">{facility.name}</h3>
      {facility.tagline && <p class="mt-2 text-sm">{facility.tagline}</p>}
      {
        facility.address.street && (
          <address class="mt-4 not-italic text-sm">
            {facility.address.street}
            <br />
            {facility.address.postal_code} {facility.address.locality} ({facility.address.region})
          </address>
        )
      }
    </div>

    <div>
      <h3 class="text-lg font-semibold text-white">Contatti</h3>
      <ul class="mt-2 space-y-1 text-sm">
        {
          facility.contacts.email && (
            <li>
              <a href={`mailto:${facility.contacts.email}`}>{facility.contacts.email}</a>
            </li>
          )
        }
        {
          facility.contacts.phone && (
            <li>
              <a href={`tel:${facility.contacts.phone.replace(/\s+/g, '')}`}>
                {facility.contacts.phone}
              </a>
            </li>
          )
        }
        {
          facility.contacts.whatsapp && (
            <li>
              <a
                href={`https://wa.me/${facility.contacts.whatsapp.replace(/[^0-9]/g, '')}`}
                rel="noopener"
              >
                WhatsApp
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <div>
      <h3 class="text-lg font-semibold text-white">Documenti</h3>
      <ul class="mt-2 space-y-1 text-sm">
        {
          FOOTER_NAV.map((entry) => (
            <li>
              <a href={entry.href}>{entry.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-700">
    <div class="mx-auto max-w-6xl px-4 py-4 text-xs text-slate-400">
      © {new Date().getFullYear()}
      {facility.gdpr.titolare ?? facility.name}. Powered by MOROSUITE.
    </div>
  </div>
</footer>
