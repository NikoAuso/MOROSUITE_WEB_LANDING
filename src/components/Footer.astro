---
import { config } from '@/lib/config';
import { PRIMARY_NAV, FOOTER_NAV } from '@/lib/navigation';
import type { SitePayload } from '@/lib/dto';
import type { NavEntry } from '@/lib/sections';
import BrandLogo from '@/components/BrandLogo.astro';
import CtaButton from '@/components/CtaButton.astro';
import Icon from '@/components/Icon.astro';
import { FALLBACK_COPY } from '@/lib/copy';
import { mapsUrl, safeHref } from '@/lib/format';

interface Props {
  site: SitePayload;
  /** Menu entries; defaults to the deploy's own. */
  nav?: readonly NavEntry[];
}

const { site, nav = PRIMARY_NAV } = Astro.props;
// Per-deploy switch + label override for the manager button (site.config.ts);
// the URL still comes from the backend.
const managerConfig = config.headerLinks.manager;
const manager =
  managerConfig.enabled && site.links?.manager
    ? { ...site.links.manager, label: managerConfig.label || site.links.manager.label }
    : null;

const mapsHref = mapsUrl(site.address);

const phone = site.contacts?.phone;
const phoneTel = phone ? `tel:${phone.replace(/\s+/g, '')}` : null;
const email = site.contacts?.email;
const emailHref = email ? `mailto:${email}` : null;

const instagram = safeHref(site.social?.instagram);
const facebook = safeHref(site.social?.facebook);
const tiktok = safeHref(site.social?.tiktok);
---

<footer class="bg-brand-950 border-t border-white/10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <!-- Brand + social -->
      <div>
        <div class="flex items-center gap-3">
          <BrandLogo alt={site.name ?? 'Logo'} class="size-15 text-brand-500" />
          <div class="text-lg font-extrabold text-white">{site.short_name ?? site.name}</div>
        </div>
        {site.tagline && <p class="mt-4 text-sm text-white/70">{site.tagline}</p>}

        <div class="mt-6 flex gap-3">
          {
            instagram && (
              <a
                href={instagram}
                aria-label="Instagram"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-pink-500 transition hover:bg-pink-500 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-brand-950"
              >
                <Icon name="fa6-brands:instagram" class="text-lg" />
              </a>
            )
          }
          {
            facebook && (
              <a
                href={facebook}
                aria-label="Facebook"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-blue-600 transition hover:bg-blue-600 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-brand-950"
              >
                <Icon name="fa6-brands:facebook-f" class="text-lg" />
              </a>
            )
          }
          {
            tiktok && (
              <a
                href={tiktok}
                aria-label="TikTok"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-brand-950"
              >
                <Icon name="fa6-brands:tiktok" class="text-lg" />
              </a>
            )
          }
        </div>
      </div>

      <!-- Link Rapidi -->
      <div>
        <div class="text-sm font-extrabold text-white">Link Rapidi</div>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          {
            nav.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-brand-950"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Risorse utili -->
      <div>
        <div class="text-sm font-extrabold text-white">Risorse utili</div>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          {
            FOOTER_NAV.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-brand-950"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            {
              /* Reopens the consent banner. Hidden until the banner's script
                claims it, so it never renders as a dead control with JS off. */
            }
            <button
              type="button"
              data-cookie-preferences
              hidden
              class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-brand-950"
            >
              Preferenze cookie
            </button>
          </li>
        </ul>
      </div>

      <!-- Contatti -->
      <div>
        <div class="text-sm font-extrabold text-white">Contatti</div>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          {
            mapsHref && site.address.street && (
              <li>
                <a
                  href={mapsHref}
                  class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-brand-950"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {site.address.street} – {site.address.postal_code} {site.address.locality} (
                  {site.address.region})
                </a>
              </li>
            )
          }
          {
            phoneTel && (
              <li>
                <a
                  href={phoneTel}
                  class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-brand-950"
                >
                  {phone}
                </a>
              </li>
            )
          }
          {
            emailHref && (
              <li>
                <a
                  href={emailHref}
                  class="hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-brand-950"
                >
                  {email}
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <!-- Azienda -->
      <div>
        <div class="text-sm font-extrabold text-white">Azienda</div>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          {
            site.gdpr.titolare && (
              <li>
                <span class="font-semibold text-white/90">{site.gdpr.titolare}</span>
              </li>
            )
          }
          {
            site.address.street && (
              <li>
                Sede legale: {site.address.street}, {site.address.postal_code}{' '}
                {site.address.locality} ({site.address.region})
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-8 text-sm text-white/60 lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="text-center lg:text-left">
        © {new Date().getFullYear()} · {site.gdpr.titolare ?? site.name} · Tutti i diritti riservati.
      </div>
      <CtaButton
        link={manager}
        fallbackLabel={FALLBACK_COPY.cta.manager}
        hideWhenMissing={!managerConfig.enabled}
        class="inline-flex w-full items-center justify-center rounded-full border border-brand-300/30 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:border-brand-200/60 hover:bg-brand-500/20 sm:w-auto lg:justify-self-end"
      />
    </div>
  </div>
</footer>
