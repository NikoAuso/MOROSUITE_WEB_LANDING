---
import { config } from '@/lib/config';
import { PRIMARY_NAV, FOOTER_NAV } from '@/lib/navigation';
import type { SitePayload } from '@/lib/dto';
import CtaButton from '@/components/CtaButton.astro';
import { FALLBACK_COPY } from '@/lib/copy';
import { safeHref } from '@/lib/format';

interface Props {
  site: SitePayload;
}

const { site } = Astro.props;
const login = site.links?.login ?? null;

// The backend-curated pin is canonical; only synthesize a locality+region
// search when google_maps_url is absent (per the dto contract).
const mapsQuery = [site.address.locality, site.address.region].filter(Boolean).join(' ');
const mapsUrl =
  safeHref(site.address.google_maps_url) ??
  (mapsQuery
    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`
    : null);

const phone = site.contacts?.phone;
const phoneTel = phone ? `tel:${phone.replace(/\s+/g, '')}` : null;
const email = site.contacts?.email;
const emailHref = email ? `mailto:${email}` : null;

const instagram = safeHref(site.social?.instagram);
const facebook = safeHref(site.social?.facebook);
const tiktok = safeHref(site.social?.tiktok);
---

<footer class="bg-slate-900 border-t border-white/10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <!-- Brand + social -->
      <div>
        <div class="flex items-center gap-3">
          <div class="flex size-15 items-center justify-center rounded-lg overflow-hidden">
            <img
              src={config.brand.logoUrl}
              alt={site.name ?? 'Logo'}
              class="h-full w-full object-contain"
            />
          </div>
          <div class="text-lg font-extrabold text-white">{site.short_name ?? site.name}</div>
        </div>
        <p class="mt-4 text-sm text-white/70">
          La destinazione perfetta per il tuo relax estivo. Tuffati in un mondo di freschezza e
          divertimento.
        </p>

        <div class="mt-6 flex gap-3">
          {
            instagram && (
              <a
                href={instagram}
                aria-label="Instagram"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-pink-500 transition hover:bg-pink-500 hover:text-white"
              >
                <i class="fa-brands fa-instagram text-lg" />
              </a>
            )
          }
          {
            facebook && (
              <a
                href={facebook}
                aria-label="Facebook"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-blue-600 transition hover:bg-blue-600 hover:text-white"
              >
                <i class="fa-brands fa-facebook-f text-lg" />
              </a>
            )
          }
          {
            tiktok && (
              <a
                href={tiktok}
                aria-label="TikTok"
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-black"
              >
                <i class="fa-brands fa-tiktok text-lg" />
              </a>
            )
          }
        </div>
      </div>

      <!-- Link Rapidi -->
      <div>
        <div class="text-sm font-extrabold text-white">Link Rapidi</div>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          {
            PRIMARY_NAV.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Risorse utili -->
      <div>
        <div class="text-sm font-extrabold text-white">Risorse utili</div>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          {
            FOOTER_NAV.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contatti -->
      <div>
        <div class="text-sm font-extrabold text-white">Contatti</div>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          {
            mapsUrl && site.address.street && (
              <li>
                <a
                  href={mapsUrl}
                  class="hover:text-white"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {site.address.street} – {site.address.postal_code} {site.address.locality} (
                  {site.address.region})
                </a>
              </li>
            )
          }
          {
            phoneTel && (
              <li>
                <a href={phoneTel} class="hover:text-white">
                  {phone}
                </a>
              </li>
            )
          }
          {
            emailHref && (
              <li>
                <a href={emailHref} class="hover:text-white">
                  {email}
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <!-- Azienda -->
      <div>
        <div class="text-sm font-extrabold text-white">Azienda</div>
        <ul class="mt-4 space-y-2 text-sm text-white/70">
          {
            site.gdpr.titolare && (
              <li>
                <span class="font-semibold text-white/90">{site.gdpr.titolare}</span>
              </li>
            )
          }
          {
            site.address.street && (
              <li>
                Sede legale: {site.address.street}, {site.address.postal_code}{' '}
                {site.address.locality} ({site.address.region})
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-8 text-sm text-white/60 lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="text-center lg:text-left">
        © {new Date().getFullYear()}
        {site.gdpr.titolare ?? site.name} · Tutti i diritti riservati.
      </div>
      <CtaButton
        link={login}
        fallbackLabel={FALLBACK_COPY.cta.login}
        class="inline-flex w-full items-center justify-center rounded-full border border-sky-300/30 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:border-sky-200/60 hover:bg-sky-500/20 sm:w-auto lg:justify-self-end"
      />
    </div>
  </div>
</footer>
