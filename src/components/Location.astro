---
import Icon from '@/components/Icon.astro';
import type { SitePayload } from '@/lib/dto';
import type { LocationContent } from '@/lib/sections';
import { mapsUrl } from '@/lib/format';

interface Props {
  id: string;
  site: SitePayload;
  content: LocationContent;
}

const { id, site, content } = Astro.props;
const { eyebrow, title, lead, items, mapsLabel, image } = content;
const { address } = site;
const mapsHref = mapsUrl(address);
const line1 = address.street;
const line2 = [address.postal_code, address.locality, address.region && `(${address.region})`]
  .filter(Boolean)
  .join(' ');
---

<section id={id} class="bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-25">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6">
        <div class="text-xs font-semibold tracking-widest text-brand-700">{eyebrow}</div>
        <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900">{title}</h2>
        {lead && <p class="mt-4 text-slate-600">{lead}</p>}

        {
          (line1 || line2) && (
            <address class="mt-6 not-italic text-lg font-semibold text-slate-900">
              {line1 && <div>{line1}</div>}
              {line2 && <div class="text-slate-600 font-normal">{line2}</div>}
            </address>
          )
        }

        <div class="mt-8 space-y-5">
          {
            items.map((item) => (
              <div class="flex gap-4">
                <div class="mt-1 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
                  <Icon name={item.icon} class="text-xl leading-none" />
                </div>
                <div>
                  <div class="font-extrabold text-slate-900">{item.title}</div>
                  <div class="mt-1 text-sm text-slate-600">{item.text}</div>
                </div>
              </div>
            ))
          }
        </div>

        {
          mapsHref && (
            <a
              href={mapsHref}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex items-center gap-2 rounded-2xl bg-cta-700 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:bg-cta-800 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500"
            >
              <Icon name="fa6-solid:location-dot" />
              {mapsLabel}
            </a>
          )
        }
      </div>

      {
        image && (
          <div class="lg:col-span-6">
            <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-slate-200 shadow-sm ring-1 ring-slate-200">
              <img
                src={image.src}
                alt={image.alt}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
                width="800"
                height="600"
              />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
