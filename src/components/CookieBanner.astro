---

---

<div
  id="cookie-banner"
  class="fixed bottom-4 left-4 right-4 hidden rounded-lg bg-white p-4 shadow-xl ring-1 ring-slate-200 md:left-auto md:right-4 md:max-w-md"
  data-storage-key="cookie-consent-v1"
  data-ttl-days="180"
>
  <p class="text-sm text-slate-700">
    Questo sito utilizza cookie tecnici e, previo consenso, cookie analitici di Google Analytics 4.
    Leggi la <a href="/cookie" class="underline">Cookie Policy</a>.
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    <button
      id="cookie-accept"
      class="rounded bg-brand-primary px-3 py-2 text-sm font-semibold text-white"
    >
      Accetta
    </button>
    <button
      id="cookie-decline"
      class="rounded border border-slate-300 px-3 py-2 text-sm font-semibold"
    >
      Rifiuta
    </button>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  if (banner) {
    const key = banner.dataset.storageKey ?? 'cookie-consent-v1';
    const ttlDays = Number(banner.dataset.ttlDays ?? '180');

    const stored = (() => {
      try {
        const raw = localStorage.getItem(key);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as { value: 'granted' | 'denied'; expires: number };
        if (parsed.expires < Date.now()) return null;
        return parsed.value;
      } catch {
        return null;
      }
    })();

    if (!stored) {
      banner.classList.remove('hidden');
    } else {
      applyConsent(stored);
    }

    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      persist('granted');
      applyConsent('granted');
      banner.classList.add('hidden');
    });

    document.getElementById('cookie-decline')?.addEventListener('click', () => {
      persist('denied');
      applyConsent('denied');
      banner.classList.add('hidden');
    });

    function persist(value: 'granted' | 'denied'): void {
      const expires = Date.now() + ttlDays * 24 * 60 * 60 * 1000;
      localStorage.setItem(key, JSON.stringify({ value, expires }));
    }

    function applyConsent(value: 'granted' | 'denied'): void {
      type Gtag = (
        cmd: 'consent',
        action: 'update',
        payload: Record<string, 'granted' | 'denied'>,
      ) => void;
      const gtag = (window as unknown as { gtag?: Gtag }).gtag;
      if (typeof gtag === 'function') {
        gtag('consent', 'update', {
          ad_storage: value,
          analytics_storage: value,
          ad_user_data: value,
          ad_personalization: value,
        });
      }
    }
  }
</script>
