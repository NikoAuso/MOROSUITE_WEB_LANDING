---
import { config } from '@/lib/config';
import type { SitePayload } from '@/lib/dto';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import '@/styles/tokens.css';

interface Props {
  title: string;
  description: string;
  site: SitePayload;
  canonical?: string;
  ogImage?: string;
  bodyClass?: string;
  showNav?: boolean;
  jsonLd?: Record<string, unknown> | null;
  preloadHeroImage?: string;
}

const {
  title,
  description,
  site,
  canonical,
  ogImage,
  bodyClass,
  showNav = true,
  jsonLd = null,
  preloadHeroImage,
} = Astro.props;

const canonicalUrl = canonical ?? `${config.siteUrl}${Astro.url.pathname}`;
const ogImageUrl = ogImage ?? `${config.siteUrl}${config.brand.ogImageUrl}`;
---

<!doctype html>
<html lang={config.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {preloadHeroImage && <link rel="preload" as="image" href={preloadHeroImage} />}

    {/* Open Graph + Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}

    {/* Favicon — demo placeholder from site.config.ts. Replace with the
        real favicon family (.ico/.svg/apple-touch/manifest) on a real deploy. */}
    <link rel="icon" href={config.brand.faviconUrl} />
    <link rel="apple-touch-icon" href={config.brand.faviconUrl} />

    {/* Fonts: Instrument Sans via Bunny Fonts (GDPR-friendly Google Fonts mirror) */}
    {/* Loaded non-blocking via media=print + onload swap; display=swap shows a fallback face meanwhile. */}
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.bunny.net" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="https://fonts.bunny.net/instrument-sans/files/instrument-sans-latin-700-normal.woff2"
    />
    <link
      href="https://fonts.bunny.net/css?family=instrument-sans:400,500,600,700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.bunny.net/css?family=instrument-sans:400,500,600,700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {/* GA4 consent mode v2 — default denied; the cookie banner upgrades to granted */}
    {config.analytics.ga4MeasurementId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${config.analytics.ga4MeasurementId}`}
        />
        <script
          is:inline
          define:vars={{
            measurementId: config.analytics.ga4MeasurementId,
            consentDefault: config.analytics.consentDefault,
          }}
        >
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          window.gtag = gtag;
          gtag('consent', 'default', {
            ad_storage: consentDefault,
            analytics_storage: consentDefault,
            ad_user_data: consentDefault,
            ad_personalization: consentDefault,
            wait_for_update: 500,
          });
          gtag('js', new Date());
          gtag('config', measurementId, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>

  <body class:list={['bg-slate-50 text-slate-900', bodyClass]}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-slate-900 focus:shadow-lg">
      Salta al contenuto
    </a>
    <Header site={site} showNav={showNav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer site={site} />
    <CookieBanner />
  </body>
</html>
