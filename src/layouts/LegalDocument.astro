---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { render, type CollectionEntry } from 'astro:content';
import type { SitePayload } from '@/lib/dto';

interface Props {
  entry: CollectionEntry<'legal'>;
  site: SitePayload;
}

const { entry, site } = Astro.props;
const { Content } = await render(entry);
const { title, version, effective_date } = entry.data;

const description = `${title} — versione ${version}.`;

const formattedEffective = effective_date
  ? effective_date.toLocaleDateString('it-IT', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    })
  : null;
---

<PublicLayout title={title} description={description} site={site} showNav={false}>
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
      <article>
        <div class="bg-white rounded-2xl shadow p-6 sm:p-8">
          <div class="mb-6 flex flex-wrap items-center gap-3 text-xs text-gray-500">
            <span
              class="inline-flex items-center rounded-full bg-sky-100 px-3 py-1 font-semibold text-sky-700"
            >
              Versione {version}
            </span>
            {formattedEffective && <span>Data di efficacia: {formattedEffective}</span>}
          </div>
          <div class="prose prose-neutral max-w-none">
            <Content />
          </div>
        </div>
      </article>
    </div>
  </section>
</PublicLayout>

<style is:global>
  /* Tipografia Markdown per i documenti legali. */
  .prose h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #1f2937;
  }
  .prose h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #374151;
  }
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #4b5563;
  }
  .prose h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #4b5563;
  }
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .prose a {
    color: #0369a1;
    text-decoration: underline;
  }
  .prose a:hover {
    color: #075985;
  }
  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .prose ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose blockquote {
    border-left: 4px solid #e5e7eb;
    padding-left: 1rem;
    color: #6b7280;
    font-style: italic;
    margin: 1rem 0;
  }
  .prose code {
    background-color: #f3f4f6;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }
  .prose pre {
    background-color: #111827;
    color: #f9fafb;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }
  .prose th,
  .prose td {
    border: 1px solid #d1d5db;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose th {
    background-color: #f9fafb;
    font-weight: 600;
  }
</style>
