---
import PublicLayout from '@/layouts/PublicLayout.astro';
import ServiceUnavailable from '@/components/ServiceUnavailable.astro';
import ErrorState from '@/components/ErrorState.astro';
import { api } from '@/lib/api';

const site = await api.site();

const title = 'Pagina non trovata';
const description = 'La pagina che stai cercando non esiste o è stata spostata.';
---

{
  site ? (
    <PublicLayout title={title} description={description} site={site} noindex={true}>
      <ErrorState code="404" title={title} description={description} as="h1" />
    </PublicLayout>
  ) : (
    <ServiceUnavailable />
  )
}
