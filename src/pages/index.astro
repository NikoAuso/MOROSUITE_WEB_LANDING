---
import PublicLayout from '@/layouts/PublicLayout.astro';
import ServiceUnavailable from '@/components/ServiceUnavailable.astro';
import { api } from '@/lib/api';
import Hero from '@/components/Hero.astro';
import PoolFeatures from '@/components/PoolFeatures.astro';
import OpeningHours from '@/components/OpeningHours.astro';
import PricingTables from '@/components/PricingTables.astro';
import Servizi from '@/components/Servizi.astro';
import Regolamento from '@/components/Regolamento.astro';
import Bar from '@/components/Bar.astro';

// Fetch /site first: when it is null the page renders <ServiceUnavailable> and
// the hours/pricing payloads are discarded, so issuing them during an outage
// only wastes two retry/backoff round-trips per request.
const site = await api.site();
const [hours, pricing] = site
  ? await Promise.all([api.openingHours(), api.pricing()])
  : [null, null];

if (!site) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}

const siteName = site?.name ?? site?.short_name ?? 'Piscina';
const title = `${siteName} | Prenota ingresso e ombrellone`;
const description = site?.tagline ?? `Scopri ${siteName} e prenota la tua giornata di relax.`;
---

{
  site ? (
    <PublicLayout
      title={title}
      description={description}
      site={site}
      preloadHeroImage="https://picsum.photos/seed/poolside/1920/1080"
    >
      <Hero site={site} />
      <PoolFeatures />
      <OpeningHours hours={hours} site={site} />
      <PricingTables pricing={pricing} site={site} />
      <Servizi />
      <Regolamento site={site} />
      <Bar site={site} />
    </PublicLayout>
  ) : (
    <ServiceUnavailable />
  )
}
