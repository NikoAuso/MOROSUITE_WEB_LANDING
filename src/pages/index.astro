---
import LandingPage from '@/components/LandingPage.astro';
import ServiceUnavailable from '@/components/ServiceUnavailable.astro';
import { api } from '@/lib/api';
import { siteContent } from '@content';
import { enabledSections } from '@/lib/sections';

const sections = enabledSections(siteContent.sections);
// Single fetch, single payload: with (contrived) duplicate hours/pricing
// sections, the FIRST one's `source` decides the fetch and every duplicate
// renders that same payload. Duplicates also collide on anchor ids — don't.
const hoursSection = sections.find((section) => section.type === 'hours');
const pricingSection = sections.find((section) => section.type === 'pricing');

// Fetch /site first: when it is null the page renders <ServiceUnavailable> and
// the hours/pricing payloads are discarded, so issuing them during an outage
// only wastes two retry/backoff round-trips per request. The two follow-ups
// are also skipped outright when no enabled section consumes them.
const site = await api.site();
// Each data-driven section resolves its own source (section override first,
// deploy default otherwise) — a static section costs no network even when the
// rest of the deploy is backend-driven, and vice versa.
const [hours, pricing] = site
  ? await Promise.all([
      hoursSection?.type === 'hours'
        ? api.openingHours(hoursSection.data.source)
        : Promise.resolve(null),
      pricingSection?.type === 'pricing'
        ? api.pricing(pricingSection.data.source)
        : Promise.resolve(null),
    ])
  : [null, null];

if (!site) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}
---

{
  site ? (
    <LandingPage content={siteContent} site={site} hours={hours} pricing={pricing} />
  ) : (
    <ServiceUnavailable />
  )
}
