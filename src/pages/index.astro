---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { api } from '@/lib/api';
import Hero from '@/components/Hero.astro';
import PoolFeatures from '@/components/PoolFeatures.astro';
import OpeningHours from '@/components/OpeningHours.astro';
import PricingTables from '@/components/PricingTables.astro';
import Servizi from '@/components/Servizi.astro';
import Regolamento from '@/components/Regolamento.astro';
import Bar from '@/components/Bar.astro';

const [facility, hours, pricing] = await Promise.all([
  api.facility(),
  api.openingHours(),
  api.pricing(),
]);

const title = `${facility.name ?? 'Piscina Morobello'} | Prenota ingresso e ombrellone`;
const description =
  facility.tagline ??
  `Rilassati nelle piscine di ${facility.short_name ?? 'Morobello'}, per un'esperienza di benessere unica e rigenerante.`;
---

<PublicLayout
  title={title}
  description={description}
  preloadHeroImage="/images/customers/solarium-giardino.webp"
>
  <Hero facility={facility} />
  <PoolFeatures />
  <OpeningHours hours={hours} facility={facility} />
  <PricingTables pricing={pricing} />
  <Servizi />
  <Regolamento facility={facility} />
  <Bar />
</PublicLayout>
