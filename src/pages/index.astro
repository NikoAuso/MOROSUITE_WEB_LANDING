---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { api } from '@/lib/api';
import Hero from '@/components/Hero.astro';
import PoolFeatures from '@/components/PoolFeatures.astro';
import OpeningHours from '@/components/OpeningHours.astro';
import PricingTables from '@/components/PricingTables.astro';
import Servizi from '@/components/Servizi.astro';
import Regolamento from '@/components/Regolamento.astro';
import Bar from '@/components/Bar.astro';

const [site, hours, pricing] = await Promise.all([
  api.site(),
  api.openingHours(),
  api.pricing(),
]);

const siteName = site.name ?? site.short_name ?? 'Piscina';
const title = `${siteName} | Prenota ingresso e ombrellone`;
const description =
  site.tagline ??
  `Scopri ${siteName} e prenota la tua giornata di relax.`;
---

<PublicLayout
  title={title}
  description={description}
  preloadHeroImage="https://picsum.photos/seed/poolside/1920/1080"
>
  <Hero site={site} />
  <PoolFeatures />
  <OpeningHours hours={hours} site={site} />
  <PricingTables pricing={pricing} site={site} />
  <Servizi />
  <Regolamento site={site} />
  <Bar site={site} />
</PublicLayout>
