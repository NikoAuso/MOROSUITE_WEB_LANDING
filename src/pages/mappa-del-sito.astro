---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { config } from '@/lib/config';
import { PRIMARY_NAV, FOOTER_NAV } from '@/lib/navigation';
import { api } from '@/lib/api';

const facility = await api.facility();

const title = `Mappa del sito | ${facility.short_name ?? facility.name ?? 'Piscina'}`;
const description = 'Tutte le pagine pubbliche del sito, raggruppate per categoria.';

const mainSiteLinks = [
  { href: '/', label: 'Home' },
  ...PRIMARY_NAV.map((n) => ({ href: n.href, label: n.label })),
];

const legalDocumentsLinks = FOOTER_NAV.map((n) => ({ href: n.href, label: n.label }));

const hotelUrl = facility.external_links?.hotel ?? null;
const restrictedAreaLinks = [
  { href: `${config.coreAppUrl}/login`, label: 'Accesso clienti' },
  { href: `${config.coreAppUrl}/register`, label: 'Registrazione' },
  ...(hotelUrl ? [{ href: hotelUrl, label: 'Sito hotel' }] : []),
];
---

<PublicLayout title={title} description={description}>
  {/* Hero */}
  <section class="bg-gradient-to-b from-sky-900 to-sky-700 text-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <div class="text-xs font-semibold tracking-widest text-sky-200">NAVIGAZIONE</div>
      <h1 class="mt-3 text-4xl lg:text-5xl font-extrabold tracking-tight">Mappa del sito</h1>
      <p class="mt-5 max-w-3xl text-lg text-sky-50/90">
        Tutte le pagine pubbliche del sito, raggruppate per categoria.
      </p>
    </div>
  </section>

  {/* Categorie */}
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {/* Sito principale */}
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <div class="text-xs font-semibold tracking-widest text-sky-700">SITO PRINCIPALE</div>
          <ul class="mt-4 space-y-2 text-sm">
            {mainSiteLinks.map((link) => (
              <li>
                <a href={link.href} class="text-slate-700 hover:text-sky-700 hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </article>

        {/* Documenti legali */}
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <div class="text-xs font-semibold tracking-widest text-sky-700">DOCUMENTI LEGALI</div>
          <ul class="mt-4 space-y-2 text-sm">
            {legalDocumentsLinks.map((link) => (
              <li>
                <a href={link.href} class="text-slate-700 hover:text-sky-700 hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </article>

        {/* Area riservata */}
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <div class="text-xs font-semibold tracking-widest text-sky-700">AREA RISERVATA</div>
          <ul class="mt-4 space-y-2 text-sm">
            {restrictedAreaLinks.map((link) => (
              <li>
                <a href={link.href} class="text-slate-700 hover:text-sky-700 hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>
</PublicLayout>
