---
import LegalDocument from '@/layouts/LegalDocument.astro';
import ServiceUnavailable from '@/components/ServiceUnavailable.astro';
import { api } from '@/lib/api';
import { getEntry } from 'astro:content';

const [site, entry] = await Promise.all([api.site(), getEntry('legal', 'cookie')]);

if (!entry) {
  return new Response(null, { status: 404 });
}

if (!site) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}
---

{
  site ? (
    <LegalDocument entry={entry} site={site} siteName={site.name ?? site.short_name ?? undefined} />
  ) : (
    <ServiceUnavailable />
  )
}
