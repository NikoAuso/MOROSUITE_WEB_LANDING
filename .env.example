# Optional. Override the inline default in src/lib/config.ts.
# Absolute URL of the backend that implements the contract in src/lib/dto.ts.
API_BASE_URL=

# Optional. Override the inline default in src/lib/config.ts.
# Base URL of the booking app. Only used to build the offline `links.*.url`
# values in src/lib/placeholders.ts (booking/login/register CTAs); when the
# backend is reachable, those URLs come from SitePayload.links.
APP_BASE_URL=

# Optional. Canonical URL of this static site (used for canonical, sitemap, OG).
PUBLIC_SITE_URL=http://localhost:4321

# Optional. Google Analytics 4 measurement ID (consent-mode v2). Empty = no tag injected.
PUBLIC_GA4_MEASUREMENT_ID=

# Optional. Secret for revalidate hooks (if any).
REVALIDATE_SECRET=replace-me

# Optional. Toggle Google sitemap ping on production builds.
SITEMAP_PING_GOOGLE=true
