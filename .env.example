# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# When "true", the site serves STATIC_DATA (the preset's demo-data.ts) and never
# calls a backend — ideal for a first run after cloning. Set to "false" (or
# remove) for a real deploy that talks to your backend.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Backend (ignored while DEMO_MODE=true)
# ---------------------------------------------------------------------------
# Absolute root URL of the backend implementing the contract in src/lib/dto.ts.
# Full endpoint URLs are composed as ${API_BASE_URL}/${FACILITY_SLUG}/site, etc.
API_BASE_URL=http://127.0.0.1:8000/api/public/v1

# Slug of the facility this deploy serves; inserted right after /v1/.
FACILITY_SLUG=demo

# Bearer token sent on every backend call (except the /up health probe).
# Server-only: no PUBLIC_ prefix, never bundled into client code.
API_AUTH_TOKEN=

# In-process cache TTL (seconds) per endpoint. Default 300 when unset.
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical URL of this site (canonical tags, sitemap, OG).
PUBLIC_SITE_URL=http://localhost:4321

# Google Analytics 4 measurement ID (consent-mode v2). Empty = no tag injected.
PUBLIC_GA4_MEASUREMENT_ID=
